# ===== 官网门户 Nginx 配置模板（可选，用于多站点宿主机统一入口） =====
# 若门户容器直接对外，可不用本模板（Nitro 自带 HTTP 服务）。
# 注意：/api 与 /static 由 Nitro 内部代理到后端（NUXT_API_INTERNAL_BASE），
# nginx 只需把整站转发给 portal 容器，无需单独配置 /api 反代。
# ${DOMAIN} 占位符由容器启动时 envsubst 替换（沿用 monorepo 部署模式）。

server {
    listen 80;
    server_name www.${DOMAIN};

    access_log /var/log/nginx/portal-access.log;
    error_log  /var/log/nginx/portal-error.log warn;

    client_max_body_size 10M;

    # 整站转发到 Nitro
    location / {
        proxy_pass http://portal:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # ===== 安全头 =====
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
}
