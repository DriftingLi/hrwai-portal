# ===== 官网门户环境变量示例 =====

# SSR 直连后端的内部地址（docker 网络用 http://backend:8080）
NUXT_API_INTERNAL_BASE=http://127.0.0.1:8080

# canonical / OG / sitemap 使用的 www 站点地址（裸域会自动补 www 前缀）。
# 注意：请用 PORTAL_SITE_URL 而非 NUXT_PUBLIC_SITE_URL（后者会绕过 www 归一化）。
PORTAL_SITE_URL=https://www.example.com

# 百度站长平台验证码（留空则不输出验证 meta）
NUXT_PUBLIC_BAIDU_VERIFICATION=
